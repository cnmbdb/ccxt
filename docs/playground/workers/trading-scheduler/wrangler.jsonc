{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "binance-agent-trading-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "binance-agent-botos",
      "database_id": "8b2571dd-c26b-4265-9ff5-3dfd595ae300"
    }
  ]
}
